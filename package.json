{
  "name": "midway-contracts",
  "version": "1.0.0",
  "description": "Cross-chain payment infrastructure powered by LayerZero",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "clean": "hardhat clean",
    "deploy:core": "hardhat run scripts/deploy.ts --network optimism-sepolia",
    "deploy:eth": "hardhat run scripts/deploy.ts --network eth-sepolia",
    "deploy:zora": "hardhat run scripts/deploy.ts --network zora-sepolia",
    "deploy:base": "hardhat run scripts/deploy.ts --network base-sepolia",
    "deploy:worldchain": "hardhat run scripts/deploy.ts --network worldchain-sepolia",
    "deploy:ink": "hardhat run scripts/deploy.ts --network ink-sepolia",
    "deploy:unichain": "hardhat run scripts/deploy.ts --network unichain-sepolia",
    "deploy:polygon": "hardhat run scripts/deploy.ts --network polygon-amoy",
    "fix:remotes": "hardhat run scripts/fix-trusted-remotes-simple.ts --network optimism-sepolia",
    "debug:remotes": "hardhat run scripts/debug-trusted-remote-mismatch.ts --network optimism-sepolia",
    "debug:flow": "hardhat run scripts/debug-cross-chain-flow.ts --network optimism-sepolia",
    "check:balance": "hardhat run scripts/check-balance-simple.ts --network optimism-sepolia"

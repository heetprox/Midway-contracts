{
  "name": "midway-contracts",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:core": "hardhat ignition deploy ignition/modules/MidPayCore.ts --network optimism-sepolia --parameters '{\"networkName\": \"optimism-sepolia\"}'",
    "deploy:eth": "hardhat ignition deploy ignition/modules/MidPayClient.ts --network eth-sepolia --parameters '{\"networkName\": \"eth-sepolia\", \"coreAddress\": \"0x0000000000000000000000000000000000000000\"}'",
    "deploy:mode": "hardhat ignition deploy ignition/modules/MidPayClient.ts --network mode-sepolia --parameters '{\"networkName\": \"mode-sepolia\", \"coreAddress\": \"0x0000000000000000000000000000000000000000\"}'",
    "deploy:zora": "hardhat ignition deploy ignition/modules/MidPayClient.ts --network zora-sepolia --parameters '{\"networkName\": \"zora-sepolia\", \"coreAddress\": \"0x0000000000000000000000000000000000000000\"}'",
    "deploy:all": "npm run deploy:core && npm run deploy:eth && npm run deploy:mode && npm run deploy:zora",
    "configure:core": "hardhat run scripts/configure-trusted-remotes.ts --network optimism-sepolia",
    "configure:eth": "hardhat run scripts/configure-trusted-remotes.ts --network eth-sepolia",
    "configure:mode": "hardhat run scripts/configure-trusted-remotes.ts --network mode-sepolia",
    "configure:zora": "hardhat run scripts/configure-trusted-remotes.ts --network zora-sepolia",
    "configure:all": "npm run configure:core && npm run configure:eth && npm run configure:mode && npm run configure:zora",
    "update-core-address": "hardhat run scripts/update-core-address.ts",
    "verify:core": "hardhat ignition verify MidPayCoreModule --network optimism-sepolia",
    "verify:eth": "hardhat ignition verify MidPayClientModule --network eth-sepolia",
    "verify:mode": "hardhat ignition verify MidPayClientModule --network mode-sepolia",
    "verify:zora": "hardhat ignition verify MidPayClientModule --network zora-sepolia",
    "clean": "hardhat clean && rm -rf ignition/deployments",
    "status": "hardhat ignition status",
    "list-deployments": "find ./ignition/deployments -name '*.json' -type f | head -20"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^0.15.5",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.11",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^20.17.2",
    "hardhat": "^2.22.15",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@layerzerolabs/solidity-examples": "^1.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^5.7.2"
  }
}